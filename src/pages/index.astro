---
import Experience from "../components/Experience.astro";
import Header from "../components/Header.astro";
import Projects from "../components/Projects.astro";
import SectionLabel from "../components/SectionLabel.astro";
import Sidebar from "../components/Sidebar.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Header
    name="Nicolas Nisoria"
    subtitle="Senior Software Engineer"
    links={[
      {
        label: "nicolas.nisoria@gmail.com",
        href: "mailto:nicolas.nisoria@gmail.com",
        icon: "email",
      },
      {
        label: "niconisoria",
        href: "https://linkedin.com/in/niconisoria",
        icon: "linkedin",
      },
      {
        label: "niconisoria",
        href: "https://github.com/niconisoria",
        icon: "github",
      },
      { label: "Book a call", href: "#", icon: "booking" },
      { label: "Download PDF", href: "#", icon: "pdf" },
    ]}
  />
  <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-[2fr_1fr]">
    <main>
      <div>
        <SectionLabel text="Summary" />
        <p class="mt-2 text-sm text-ink-900">
          Placeholder software engineer with a made-up number of years across
          fake industries, used only to stress-test layout and print/PDF output
          — not a real bio. Lorem ipsum dolor sit amet, consectetur adipiscing
          elit, sed do eiusmod tempor incididunt.
        </p>
      </div>
      <hr class="mx-auto my-6 w-24 border-t border-wood-500" />
      <div>
        <Experience
          jobs={[
            {
              title: "Staff Software Engineer",
              company: "Nimbus Systems",
              location: "Remote",
              startDate: "2023",
              endDate: "Present",
              achievements: [
                "Shipped a fake real-time dashboard feature, supporting **thousands of test users**",
                "Led a made-up modernization effort improving imaginary system stability",
                "Coordinated a fictional cross-team migration across three placeholder services",
                "Wrote sample ETL pipelines connecting dummy data sources for layout testing",
              ],
              stack: [
                "Kotlin 1.9",
                "Spring Boot 3",
                "PostgreSQL",
                "Redis",
                "Kafka",
                "React",
                "JUnit",
                "Detekt",
              ],
            },
            {
              title: "Software Engineer",
              company: "Lattice Works",
              location: "Hybrid",
              startDate: "2021-03",
              endDate: "2023-01",
              achievements: [
                "Built a placeholder permission system with a flexible fake UI",
                "Implemented dummy templates with custom components and mock API endpoints",
                "Prototyped a fictional real-time chat system for sample stakeholders",
                "Refactored sample modules and established **fabricated test coverage**",
              ],
              stack: [
                "TypeScript 4.9/5.2",
                "Next.js 12/14",
                "PostgreSQL",
                "MySQL",
                "Redis",
                "GraphQL",
                "Prisma",
                "Vue",
                "tRPC",
                "Vitest",
                "Playwright",
                "Cypress",
                "ESLint",
                "Biome",
              ],
            },
            {
              title: "Software Engineer",
              company: "BluePeak Digital",
              location: "Onsite",
              startDate: "2019-06",
              endDate: "2021-03",
              achievements: [
                "Built placeholder CMS features for a fake multi-tenant demo app",
                "Integrated mock third-party systems for sample retail operations",
                "Refactored sample legacy code and expanded fake test coverage",
              ],
              stack: [
                "Java 11",
                "Spring 5",
                "MySQL",
                "Redis",
                "RabbitMQ",
                "Hibernate",
                "jQuery",
                "JUnit",
                "Checkstyle",
              ],
            },
            {
              title: "Junior Software Engineer",
              company: "Forge Analytics",
              location: "Onsite",
              startDate: "2018-01",
              endDate: "2019-06",
              achievements: [
                "Contributed to fake greenfield backend services and sample data workflows",
                "Participated in placeholder architecture discussions on toy features",
              ],
              stack: ["Python", "Go", "Ruby", "SQLite", "MongoDB", "Celery"],
            },
          ]}
        />
      </div>
      <hr class="mx-auto my-6 w-24 border-t border-wood-500" />
      <div>
        <Projects
          items={[
            {
              title: "Task Flow CLI",
              achievements: [
                "Built a fake Go CLI translating dummy webhook requests into mock task-queue jobs, for **rate limits and partial failures** testing",
                "Designed a placeholder saga-based orchestrator with **automatic rollback** for sample multi-step operations",
                "Implemented mock ID mapping and idempotency locks to prevent duplicate sample records",
              ],
              stack: ["Go 1.22", "SQLite", "Docker", "Testify"],
            },
          ]}
        />
      </div>
    </main>
    <Sidebar
      certificates={{
        items: [
          { label: "Placeholder Cert — Cloud Fundamentals", href: "#" },
          { label: "Placeholder Cert — Distributed Systems", href: "#" },
          { label: "Placeholder Cert — Security Basics", href: "#" },
          { label: "Placeholder Cert — Agile Delivery", href: "#" },
        ],
      }}
      education={[
        {
          degree: "MSc Placeholder Engineering",
          institution: "Sample State University",
          startDate: "2014",
          endDate: "2018",
        },
      ]}
      languages={{
        caption: "Primary languages",
        items: [
          { label: "TypeScript" },
          { label: "Kotlin" },
          { label: "Go" },
          { label: "Java" },
        ],
        secondary: {
          caption: "Side-project / Fast ramp-up",
          items: ["Rust", "Elixir"],
        },
      }}
      frameworks={{
        caption: "Primary frameworks",
        items: [
          { label: "Next.js" },
          { label: "Spring Boot" },
          { label: "React" },
        ],
        secondary: {
          caption: "Also",
          items: ["GraphQL", "Prisma", "Hibernate", "RabbitMQ", "gRPC"],
        },
      }}
      selectedWork={[
        {
          label: "Task Flow CLI",
          href: "#",
        },
      ]}
    />
  </div>
</Layout>
