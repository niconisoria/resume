---
import Experience from "../components/Experience.astro";
import Header from "../components/Header.astro";
import Projects from "../components/Projects.astro";
import Sidebar from "../components/Sidebar.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <Header
    name="Nicolas Nisoria"
    subtitle="Senior Software Engineer"
    links={[
      {
        label: "nicolas.nisoria@gmail.com",
        href: "mailto:nicolas.nisoria@gmail.com",
        icon: "email",
      },
      {
        label: "niconisoria",
        href: "https://linkedin.com/in/niconisoria",
        icon: "linkedin",
      },
      {
        label: "niconisoria",
        href: "https://github.com/niconisoria",
        icon: "github",
      },
      { label: "Book a call", href: "#", icon: "booking" },
      { label: "Download PDF", href: "#", icon: "pdf" },
    ]}
  />
  <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-[2fr_1fr]">
    <main class="divide-y divide-navy-100">
      <div class="pb-6">
        <Experience
          jobs={[
            {
              title: "Senior Software Engineer",
              company: "Acme Corp",
              location: "Remote",
              startDate: "2022-01",
              endDate: "Present",
              achievements: [
                "Led migration to microservices",
                "Cut p99 latency by 40%",
              ],
              stack: ["Ruby", "Rails", "React"],
            },
          ]}
        />
      </div>
      <div class="pt-6">
        <Projects
          items={[
            {
              title: "SCIM Bridge",
              achievements: [
                "Python/FastAPI service translating Okta SCIM 2.0 requests into Brivo Access API calls",
                "Saga-based orchestrator with **automatic rollback**",
              ],
              stack: ["Python", "FastAPI", "Redis", "Docker", "Pytest"],
            },
          ]}
        />
      </div>
    </main>
    <Sidebar
      summary="Software Engineer with over 7 years of experience building and improving large-scale systems in fintech, edtech, and hrtech. Deep specialization in Ruby/Rails, with working breadth across JavaScript, Python, and PHP."
      certificates={{
        items: [{ label: "Claude with the Anthropic API", href: "#" }],
      }}
      education={[
        {
          degree: "MSc Systems Engineering",
          institution: "Universidad Tecnológica Nacional",
          startDate: "2015",
          endDate: "2020",
        },
      ]}
      languages={{
        caption: "Commercial experience / years",
        items: [
          { label: "Ruby", years: 7 },
          { label: "JavaScript/TypeScript", years: 7 },
          { label: "Python", years: 3 },
          { label: "PHP", years: 5 },
        ],
        secondary: {
          caption: "Side-project / Fast ramp-up",
          items: ["Rust", "Go"],
        },
      }}
      frameworks={{
        caption: "Production use / years",
        items: [
          { label: "Rails", years: 7 },
          { label: "React", years: 6 },
          { label: "FastAPI", years: 1 },
        ],
        secondary: {
          caption: "Side-project / Fast ramp-up",
          items: ["Astro", "Flask"],
        },
      }}
      selectedWork={[
        {
          label: "SCIM Bridge",
          href: "https://github.com/niconisoria/scim-bridge",
        },
      ]}
    />
  </div>
</Layout>
