---
import ActionLink from "./ActionLink.astro";
import EntryBody from "./EntryBody.astro";
import SectionLabel from "./SectionLabel.astro";

interface Job {
  title: string;
  company: string;
  companyHref: string;
  location: string;
  startDate: string;
  endDate: string;
  achievements: string[];
  stack: string[];
}

interface Props {
  jobs: Job[];
}

const { jobs } = Astro.props;
---

<section>
  <SectionLabel text="Experience" />
  <div class="mt-3 space-y-6">
    {jobs.map((job) => (
      <div>
        <div class="flex items-baseline justify-between gap-4">
          <div>
            <div class="text-sm font-bold text-ink-900">{job.title}</div>
            <ActionLink href={job.companyHref}>
              <span class="text-sm font-medium italic">{job.company}</span>
            </ActionLink>
          </div>
          <div class="text-right text-2xs text-ink-500">
            <div>{job.location}</div>
            <div>
              {job.startDate} – {job.endDate}
            </div>
          </div>
        </div>
        <EntryBody achievements={job.achievements} stack={job.stack} />
      </div>
    ))}
  </div>
</section>
