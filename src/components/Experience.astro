---
import ActionLink from "./ActionLink.astro";
import EntryBody from "./EntryBody.astro";
import type { ProjectGroup } from "./EntryBody.astro";
import SectionLabel from "./SectionLabel.astro";

interface Job {
  title: string;
  company: string;
  companyHref: string;
  location: string;
  startDate: string;
  endDate: string;
  achievements?: string[];
  projects?: ProjectGroup[];
  stack: string[];
}

interface Props {
  jobs: Job[];
  atsSafe?: boolean;
}

const { jobs, atsSafe = false } = Astro.props;

// Side by side, the job title/company and location/dates sit in the same
// visual row split across two columns. Chrome's PDF text extraction reads
// by Y-position, so it comes out title -> location -> dates -> company,
// which trips ATS block-parsers (e.g. Workday) expecting title -> company.
// Stacking everything into one column keeps DOM order == reading order.
const headerClass = atsSafe
  ? "flex flex-col items-start gap-1"
  : "flex items-baseline justify-between gap-4";
const datesClass = atsSafe
  ? "text-left text-2xs text-ink-500"
  : "text-right text-2xs text-ink-500";
---

<section>
  <SectionLabel text="Experience" />
  <div class="mt-3 space-y-6">
    {jobs.map((job) => (
      <div>
        <div class={headerClass}>
          <div>
            <div class="text-sm font-bold text-ink-900">{job.title}</div>
            <ActionLink href={job.companyHref}>
              <span class="text-sm font-medium italic">{job.company}</span>
            </ActionLink>
          </div>
          <div class={datesClass}>
            <div>{job.location}</div>
            <div>
              {job.startDate} – {job.endDate}
            </div>
          </div>
        </div>
        <EntryBody
          achievements={job.achievements}
          projects={job.projects}
          stack={job.stack}
        />
      </div>
    ))}
  </div>
</section>
