---
import ActionLink from "./ActionLink.astro";
import Education from "./Education.astro";
import SectionLabel from "./SectionLabel.astro";
import SkillList from "./SkillList.astro";

interface SkillGroup {
  caption?: string;
  items: { label: string; years?: number; href?: string }[];
  secondary?: { caption: string; items: string[] };
}

interface EducationEntry {
  degree: string;
  institution: string;
  institutionHref: string;
  startDate: string;
  endDate: string;
}

interface Props {
  languages: SkillGroup;
  frameworks: SkillGroup;
  education: EducationEntry[];
  certificates: SkillGroup;
  selectedWork: { company: string; project: string; href: string }[];
  educationLabel?: string;
  certificatesLabel?: string;
  languagesLabel?: string;
  frameworksLabel?: string;
  selectedWorkLabel?: string;
}

const {
  languages,
  frameworks,
  education,
  certificates,
  selectedWork,
  educationLabel = "Education",
  certificatesLabel = "Certificates",
  languagesLabel = "Languages",
  frameworksLabel = "Frameworks",
  selectedWorkLabel = "Selected Work",
} = Astro.props;
---

<aside class="self-start space-y-6 rounded-md bg-navy-100 p-4">
  <div>
    <Education items={education} sectionLabel={educationLabel} />
  </div>
  <div>
    <SkillList
      label={certificatesLabel}
      caption={certificates.caption}
      items={certificates.items}
    />
  </div>
  <div>
    <SkillList
      label={languagesLabel}
      caption={languages.caption}
      items={languages.items}
      secondary={languages.secondary}
    />
  </div>
  <div>
    <SkillList
      label={frameworksLabel}
      caption={frameworks.caption}
      items={frameworks.items}
      secondary={frameworks.secondary}
    />
  </div>
  <div>
    <SectionLabel text={selectedWorkLabel} />
    <ul class="mt-1 space-y-1">
      {selectedWork.map((item) => (
        <li>
          <span class="text-2xs text-ink-500">{item.company} / </span>
          <ActionLink href={item.href}>
            <span class="text-xs">{item.project}</span>
          </ActionLink>
        </li>
      ))}
    </ul>
  </div>
</aside>
