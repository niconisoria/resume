---
import ActionLink from "./ActionLink.astro";
import EntryBody from "./EntryBody.astro";
import SectionLabel from "./SectionLabel.astro";

interface Project {
  title: string;
  href: string;
  achievements: string[];
  stack: string[];
}

interface Props {
  items: Project[];
}

const { items } = Astro.props;
---

<section>
  <SectionLabel text="Personal Projects" />
  <div class="mt-3 space-y-6">
    {items.map((item) => (
      <div>
        <ActionLink href={item.href}>
          <span class="text-sm font-bold">{item.title}</span>
        </ActionLink>
        <EntryBody achievements={item.achievements} stack={item.stack} />
      </div>
    ))}
  </div>
</section>
