---
import ActionLink from "./ActionLink.astro";
import EntryBody from "./EntryBody.astro";
import SectionLabel from "./SectionLabel.astro";

interface Project {
  title: string;
  href: string;
  achievements: string[];
  stack: string[];
}

interface Props {
  items: Project[];
  sectionLabel?: string;
  stackLabel?: string;
}

const {
  items,
  sectionLabel = "Personal Projects",
  stackLabel = "Stack",
} = Astro.props;
---

<section>
  <SectionLabel text={sectionLabel} />
  <div class="mt-3 space-y-6">
    {items.map((item) => (
      <div>
        <ActionLink href={item.href}>
          <span class="text-sm font-bold">{item.title}</span>
        </ActionLink>
        <EntryBody
          achievements={item.achievements}
          stack={item.stack}
          stackLabel={stackLabel}
        />
      </div>
    ))}
  </div>
</section>
