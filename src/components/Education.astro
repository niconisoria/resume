---
import ActionLink from "./ActionLink.astro";
import SectionLabel from "./SectionLabel.astro";

interface Props {
  items: {
    degree: string;
    institution: string;
    institutionHref: string;
    startDate: string;
    endDate: string;
  }[];
  sectionLabel?: string;
}

const { items, sectionLabel = "Education" } = Astro.props;
---

<div>
  <SectionLabel text={sectionLabel} />
  <div class="mt-2 space-y-3">
    {items.map((item) => (
      <div>
        <div class="text-xs text-ink-900">{item.degree}</div>
        <ActionLink href={item.institutionHref}>
          <span class="text-xs font-medium">{item.institution}</span>
        </ActionLink>
        <div class="text-xs text-ink-500">
          {item.startDate}–{item.endDate}
        </div>
      </div>
    ))}
  </div>
</div>
