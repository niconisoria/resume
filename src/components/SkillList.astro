---
import ActionLink from "./ActionLink.astro";
import SectionLabel from "./SectionLabel.astro";

interface Props {
  label: string;
  caption?: string;
  items: { label: string; years?: number; href?: string }[];
  secondary?: { caption: string; items: string[] };
}

const { label, caption, items, secondary } = Astro.props;
---

<div>
  <SectionLabel text={label} />
  {caption && <p class="mt-1 text-2xs text-ink-500">{caption}</p>}
  <div class="mt-2 space-y-1">
    {items.map((item) =>
      item.href ? (
        <ActionLink href={item.href}>
          <span class="text-2xs">{item.label}</span>
        </ActionLink>
      ) : (
        <div class="text-2xs text-ink-900">
          {item.label}
          {item.years != null && (
            <span class="text-ink-500"> / {item.years}</span>
          )}
        </div>
      ),
    )}
  </div>
  {secondary && (
    <p class="mt-2 text-2xs text-ink-500 italic">
      {secondary.caption}: {secondary.items.join(" · ")}
    </p>
  )}
</div>
